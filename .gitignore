build/
.gradle/
.kotlin/
app/build/
app/build.sh

#参考源码（体积大，不进版本库）
_operit/
_dsp/

#本地日志与备份
logs/
.backup/

#崩溃日志
crashlogs/

#本机配置与临时构建文件
local.properties
.tmp/
#产物与备份
*.apk
*.aab
#AIDE 扫描索引，不是源码
workspace.json
workspace.json.bak
#内部文档（模型锚点与变更账本），不对外
.docs/

#本地工具脚本（构建 / 发版 / i18n），不进版本库
scripts/

#python
__pycache__/
*.pyc
app/.cxx/
.cxx/
#第三方库源码（体积大，按需本地放入）
app/src/main/cpp/_third_party/

# Rust 内核（cargo 产物；源码在 app/src/main/rust/，产物一律不进库）
app/src/main/rust/target/
app/src/main/rust/baiguard/target/
app/src/main/rust/android/app/build/

