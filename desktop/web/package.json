{
  "name": "baicodex-web",
  "private": true,
  "version": "2.0.0",
  "description": "baicodex 的桌面界面：Liquid Glass 组件与业务视图",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @baicodex/desktop dev",
    "build": "pnpm --filter @baicodex/desktop build",
    "preview": "pnpm --filter @baicodex/desktop preview",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint": "pnpm -r --parallel exec tsc --noEmit",
    "clean": "rm -rf packages/*/dist apps/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
