<?xml version="1.0" encoding="utf-8"?>
<!-- 更新包落在应用私有 files/update，安装器要读它，所以把 files 与 cache 都开给 FileProvider -->
<paths>
    <files-path
        name="files"
        path="." />
    <cache-path
        name="cache"
        path="." />
    <!-- AI 生成的图 / 截图常落在外部存储，要能交给系统应用打开 -->
    <external-path
        name="ext"
        path="." />
    <external-files-path
        name="extfiles"
        path="." />
    <external-cache-path
        name="extcache"
        path="." />
</paths>